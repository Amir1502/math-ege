<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_accent">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/accent_soft" />
                    <stroke android:width="@dimen/stroke_focus" android:color="@color/focus" />
                    <corners android:radius="@dimen/control_radius" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/accent_soft" />
                    <stroke android:width="@dimen/stroke_hairline" android:color="@color/focus" />
                    <corners android:radius="@dimen/control_radius" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface" />
                    <stroke android:width="@dimen/stroke_hairline" android:color="@color/control_border" />
                    <corners android:radius="@dimen/control_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
