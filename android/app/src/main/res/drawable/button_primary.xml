<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_primary">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="@color/hairline" />
                    <corners android:radius="@dimen/control_radius" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/accent_pressed" />
                    <stroke android:width="@dimen/stroke_focus" android:color="@color/ink" />
                    <corners android:radius="@dimen/control_radius" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/accent_pressed" />
                    <corners android:radius="@dimen/control_radius" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/accent" />
                    <corners android:radius="@dimen/control_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
