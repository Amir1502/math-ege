<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MathEgePreview" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/ripple_accent</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>

    <style name="Theme.MathEgeOffline" parent="Theme.MathEgePreview" />

    <style name="Text.Preview.Body" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingExtra">@dimen/space_1</item>
    </style>
    <style name="Text.Preview.Caption" parent="Text.Preview.Body">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="Text.Preview.Product" parent="Text.Preview.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_product</item>
    </style>
    <style name="Text.Preview.Heading" parent="Text.Preview.Product">
        <item name="android:textSize">@dimen/text_heading</item>
    </style>
    <style name="Text.Preview.Label" parent="Text.Preview.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Preview.Error" parent="Text.Preview.Caption">
        <item name="android:textColor">@color/error</item>
    </style>

    <style name="Widget.Preview.Button" parent="android:style/Widget.Material.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:minWidth">@dimen/secondary_height</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_3</item>
        <item name="android:paddingBottom">@dimen/space_3</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">false</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Preview.Button.Primary" parent="Widget.Preview.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/primary_button_text</item>
    </style>
    <style name="Widget.Preview.Button.Secondary" parent="Widget.Preview.Button">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/secondary_button_text</item>
        <item name="android:minHeight">@dimen/secondary_height</item>
    </style>
</resources>
