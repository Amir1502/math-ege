# Operator-managed /etc/math-ege/backup.env, readable only by the backup operator.
# This file contains settings and a password-file location, never a password.
OPS_APP_DIR=/opt/math-ege
OPS_BACKUP_DIR=/var/lib/math-ege-backups
OPS_SOURCE_DATABASE=math_ege
OPS_PROTECTED_DATABASES=math_ege
OPS_PG_CONTAINER=math-ege-db-1
# Replace with the exact deployed revision; aliases such as "head" are rejected.
OPS_EXPECTED_HEAD=REPLACE_WITH_DEPLOYED_REVISION
PGUSER=math_ege
# If authentication needs a password, mount this operator-provisioned file in the
# PostgreSQL container. Use mode 0600 and the correct container UID.
# PGPASSFILE=/run/secrets/math-ege-backup.pgpass
